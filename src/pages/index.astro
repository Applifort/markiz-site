---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/Pain.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Capabilities from '../components/Capabilities.astro';
import Pricing from '../components/Pricing.astro';
import Referral from '../components/Referral.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Маркиз — Честный знак в одном окне"
  description="Маркиз собирает документы Честного знака в одну операцию: коды, нанесение, этикетки, УПД. Для небольших производителей, импортёров и селлеров."
>
  <Nav />
  <main id="main">
    <Hero />
    <Pain />
    <HowItWorks />
    <Capabilities />
    <Pricing />
    <Referral />
    <FinalCta />
  </main>
  <Footer />
</Base>
