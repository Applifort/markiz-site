---
const pains = [
  {
    n: '01',
    title: 'Документы разъехались',
    text: 'Эмиссия в одном месте, нанесение в другом, УПД — ещё где-то. Собрать картину партии приходится вручную.',
  },
  {
    n: '02',
    title: 'Ждёте у монитора',
    text: 'Честный знак отвечает когда ответит. Официальный кабинет не отпускает: сидите и смотрите, пока документ пройдёт.',
  },
  {
    n: '03',
    title: 'Печать и УПД слабые',
    text: 'Перепечатать этикетку, собрать макет, отправить УПД — то, чего в кабинете не хватает, когда партия уже в руках.',
  },
];
---

<section class="section charcoal" id="pain">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker">Зачем не кабинет</p>
      <h2 class="big-head">Официальный кабинет — это очередь документов, а не работа.</h2>
      <p class="lead-muted">
        Маркировка обязательна. Процесс в Честном знаке — нет: он фрагментирован, медленный и плохо печатает.
      </p>
    </header>
    <div class="pain-grid">
      {
        pains.map((item) => (
          <article class="pain-card reveal">
            <p class="n">{item.n}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
