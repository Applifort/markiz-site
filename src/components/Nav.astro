---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = pathname === '/';

const siteLinks = [
  { href: '/', label: 'Главная', current: isHome },
  { href: '/docs/', label: 'База знаний', current: pathname.startsWith('/docs') },
  { href: '/partneram/', label: 'Партнёрам', current: pathname.startsWith('/partneram') },
];

const sectionLinks = [
  { href: isHome ? '#pain' : '/#pain', label: 'Боль' },
  { href: isHome ? '#how' : '/#how', label: 'Как это работает' },
  { href: isHome ? '#capabilities' : '/#capabilities', label: 'Возможности' },
  { href: isHome ? '#pricing' : '/#pricing', label: 'Цена' },
];
---

<div class="nav-wrap" id="navwrap">
  <nav class="nav" aria-label="Основная">
    <a class="logo" href="/">
      <Logo height={28} />
    </a>
    <div class="nav-links">
      {siteLinks.map((link) => (
        <a
          class="nav-link"
          href={link.href}
          aria-current={link.current ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      {sectionLinks.map((link) => (
        <a class="nav-link" href={link.href}>{link.label}</a>
      ))}
    </div>
    <div class="nav-cta">
      <a class="nav-link" href="#">Войти</a>
      <a class="btn btn-light btn-sm" href="#">Начать</a>
      <button class="nav-burger" type="button" aria-label="Открыть меню" data-open-sheet>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</div>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Меню" aria-hidden="true">
  <div class="sheet-top">
    <a class="logo" href="/" data-close-sheet>
      <Logo height={28} />
    </a>
    <button class="icon-btn" type="button" aria-label="Закрыть меню" data-close-sheet>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <div class="sheet-links">
    {siteLinks.map((link) => (
      <a href={link.href} data-close-sheet aria-current={link.current ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
    {sectionLinks.map((link) => (
      <a href={link.href} data-close-sheet>{link.label}</a>
    ))}
    <a href="#" data-close-sheet>Войти</a>
  </div>
  <a class="btn btn-light sheet-cta" href="#">Начать</a>
</div>
