---
interface Props {
  videoUrl?: string;
  videoTitle?: string;
}

const { videoUrl, videoTitle = 'Видео к статье' } = Astro.props;

const slug = Astro.locals.starlightRoute.entry.slug;
const uid = `mm-${slug.replace(/[^a-zA-Z0-9а-яА-ЯёЁ]+/g, '-') || 'page'}`;

function youtubeEmbed(url: string): string | undefined {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, '');
    if (host === 'youtu.be') {
      const id = parsed.pathname.split('/').filter(Boolean)[0];
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : undefined;
    }
    if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
      const id = parsed.searchParams.get('v') || parsed.pathname.split('/').filter(Boolean).at(-1);
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : undefined;
    }
  } catch {
    return undefined;
  }
  return undefined;
}

const embed = videoUrl ? youtubeEmbed(videoUrl) : undefined;
const nativeVideo = videoUrl && !embed ? videoUrl : undefined;
---

<markiz-media-mode class="media-mode" data-storage-key="markiz-docs-media-mode">
  <div class="media-mode__bar">
    <p class="media-mode__hint" id={`${uid}-label`}>Формат статьи</p>
    <div class="media-mode__tabs" role="tablist" aria-labelledby={`${uid}-label`}>
      <button
        type="button"
        class="media-mode__tab"
        role="tab"
        id={`${uid}-tab-read`}
        aria-controls={`${uid}-panel-read`}
        aria-selected="true"
        tabindex="0"
        data-mode="read"
      >
        Читать
      </button>
      <button
        type="button"
        class="media-mode__tab"
        role="tab"
        id={`${uid}-tab-watch`}
        aria-controls={`${uid}-panel-watch`}
        aria-selected="false"
        tabindex="-1"
        data-mode="watch"
      >
        Смотреть
      </button>
    </div>
  </div>

  <div
    class="media-mode__panel"
    role="tabpanel"
    id={`${uid}-panel-read`}
    aria-labelledby={`${uid}-tab-read`}
    data-panel="read"
  >
    <slot />
  </div>

  <div
    class="media-mode__panel"
    role="tabpanel"
    id={`${uid}-panel-watch`}
    aria-labelledby={`${uid}-tab-watch`}
    data-panel="watch"
    hidden
  >
    {
      embed ? (
        <figure class="media-mode__player">
          <div class="media-mode__frame">
            <iframe
              src={embed}
              title={videoTitle}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
          <figcaption>{videoTitle}</figcaption>
        </figure>
      ) : nativeVideo ? (
        <figure class="media-mode__player">
          <div class="media-mode__frame">
            <video controls preload="metadata" src={nativeVideo}>
              <a href={nativeVideo}>Скачать видео</a>
            </video>
          </div>
          <figcaption>{videoTitle}</figcaption>
        </figure>
      ) : (
        <div class="media-mode__empty">
          <div class="media-mode__poster" aria-hidden="true">
            <span class="media-mode__badge">Видео скоро</span>
          </div>
          <h2 class="media-mode__empty-title">{videoTitle}</h2>
          <p class="media-mode__empty-text">
            Здесь будет короткое видео с озвучкой. Сейчас можно читать статью — переключатель
            «Читать» сверху.
          </p>
        </div>
      )
    }
  </div>
</markiz-media-mode>

<script>
  class MarkizMediaMode extends HTMLElement {
    static storageKey = 'markiz-docs-media-mode';

    connectedCallback() {
      const tabs = this.querySelectorAll<HTMLButtonElement>('[role="tab"]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => this.select(tab.dataset.mode || 'read'));
        tab.addEventListener('keydown', (event) => this.onKey(event));
      });

      let mode = 'read';
      try {
        const saved = localStorage.getItem(MarkizMediaMode.storageKey);
        if (saved === 'read' || saved === 'watch') mode = saved;
      } catch {
        /* ignore quota / private mode */
      }
      this.select(mode, false);
    }

    onKey(event: KeyboardEvent) {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const current = tabs.findIndex((tab) => tab === event.currentTarget);
      if (current < 0) return;

      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
        next = (current - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;

      event.preventDefault();
      tabs[next]?.focus();
      this.select(tabs[next]?.dataset.mode || 'read');
    }

    select(mode: string, persist = true) {
      const next = mode === 'watch' ? 'watch' : 'read';
      const tabs = this.querySelectorAll<HTMLButtonElement>('[role="tab"]');
      const panels = this.querySelectorAll<HTMLElement>('[data-panel]');

      tabs.forEach((tab) => {
        const selected = tab.dataset.mode === next;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== next;
      });

      document.documentElement.dataset.mediaMode = next;
      if (!persist) return;
      try {
        localStorage.setItem(MarkizMediaMode.storageKey, next);
      } catch {
        /* ignore */
      }
    }
  }

  if (!customElements.get('markiz-media-mode')) {
    customElements.define('markiz-media-mode', MarkizMediaMode);
  }
</script>

<style>
  .media-mode {
    display: block;
  }

  .media-mode__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin: 0 0 1.35rem;
  }

  .media-mode__hint {
    margin: 0;
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #4e4a56;
    letter-spacing: 0.01em;
  }

  .media-mode__tabs {
    display: inline-flex;
    padding: 3px;
    background: #f2f0f6;
    border: 1px solid #ddd9e4;
    border-radius: 100px;
    gap: 2px;
  }

  .media-mode__tab {
    appearance: none;
    margin: 0;
    border: 0;
    background: transparent;
    color: #4e4a56;
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    padding: 8px 16px;
    border-radius: 100px;
    cursor: pointer;
  }

  .media-mode__tab:hover,
  .media-mode__tab:focus-visible {
    color: #09080c;
  }

  .media-mode__tab:focus-visible {
    outline: 2px solid #9b7ed4;
    outline-offset: 2px;
  }

  .media-mode__tab[aria-selected='true'] {
    background: #fff;
    color: #09080c;
    box-shadow: 0 1px 3px rgba(9, 8, 12, 0.08);
  }

  .media-mode__panel {
    min-height: 12rem;
  }

  .media-mode__player,
  .media-mode__empty {
    margin: 0;
  }

  .media-mode__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #09080c;
    border: 1px solid #ddd9e4;
  }

  .media-mode__frame iframe,
  .media-mode__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-mode__player figcaption {
    margin-top: 0.65rem;
    font-size: 0.95rem;
    color: #4e4a56;
  }

  .media-mode__poster {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #ddd9e4;
    background:
      radial-gradient(circle at 18% 20%, rgba(155, 126, 212, 0.28), transparent 42%),
      radial-gradient(circle at 82% 78%, rgba(227, 138, 58, 0.22), transparent 46%),
      repeating-linear-gradient(
        90deg,
        rgba(9, 8, 12, 0.05) 0 10px,
        transparent 10px 20px
      ),
      repeating-linear-gradient(
        0deg,
        rgba(9, 8, 12, 0.05) 0 10px,
        transparent 10px 20px
      ),
      #f2f0f6;
    display: grid;
    place-items: center;
  }

  .media-mode__badge {
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #09080c;
    background: #fff;
    border: 1px solid #ddd9e4;
    border-radius: 100px;
    padding: 8px 14px;
    box-shadow: 0 8px 24px -12px rgba(9, 8, 12, 0.18);
  }

  .media-mode__empty-title {
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: #09080c;
    margin: 1rem 0 0.4rem;
  }

  .media-mode__empty-text {
    margin: 0;
    max-width: 38rem;
    color: #4e4a56;
    font-size: 1rem;
    line-height: 1.55;
  }

  @media (max-width: 40rem) {
    .media-mode__bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media print {
    .media-mode__bar,
    .media-mode__panel[data-panel='watch'] {
      display: none !important;
    }

    .media-mode__panel[data-panel='read'] {
      display: block !important;
    }
  }
</style>
