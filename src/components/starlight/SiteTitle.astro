---
import Logo from '../Logo.astro';
---

<a class="site-title sl-flex" href="/docs/">
  <Logo height={28} />
  <span class="docs-label">База знаний</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 12px;
    text-decoration: none;
    min-width: 0;
    color: inherit;
  }

  .docs-label {
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #4e4a56;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
